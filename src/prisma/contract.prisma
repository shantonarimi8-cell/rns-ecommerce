// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  phone     String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  addresses Address[]
  orders    Order[]
  wishlist  Wishlist[]
}

model Address {
  id        Int      @id @default(autoincrement())
  label     String   @default("Home")
  line1     String
  line2     String?
  city      String
  region    String?
  postalCode String?
  isDefault Boolean  @default(false)

  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)

  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  products    Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)

  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])

  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  images      ProductImage[]
  variants    ProductVariant[]
  wishlist    Wishlist[]
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  url       String
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)

  productId Int
  product   Product  @relation(fields: [productId], references: [id])
}

model ProductVariant {
  id        Int      @id @default(autoincrement())
  sku       String   @unique
  size      String?
  color     String?
  price     Decimal
  stock     Int      @default(0)

  productId Int
  product   Product  @relation(fields: [productId], references: [id])

  orderItems OrderItem[]
}

model Coupon {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  type        String
  value       Decimal
  minSubtotal Decimal?
  maxUses     Int?
  usedCount   Int      @default(0)
  expiresAt   TimestamptzString?
  isActive    Boolean  @default(true)

  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  orders      Order[]
}

model Banner {
  id        Int      @id @default(autoincrement())
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Order {
  id              Int      @id @default(autoincrement())
  status          String   @default("Processing")
  paymentMethod   String   @default("Cash on Delivery")

  subtotal        Decimal
  discountAmount  Decimal  @default(0)
  total           Decimal

  deliveryAddress String
  customerName    String
  customerPhone   String
  customerEmail   String

  guestEmail      String?
  guestName       String?
  guestPhone      String?

  userId          Int?
  user            User?    @relation(fields: [userId], references: [id])

  couponId        Int?
  coupon          Coupon?  @relation(fields: [couponId], references: [id])
  couponCode      String?

  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()

  items           OrderItem[]
}

model OrderItem {
  id           Int      @id @default(autoincrement())
  quantity     Int
  unitPrice    Decimal
  productName  String
  variantLabel String

  orderId      Int
  order        Order    @relation(fields: [orderId], references: [id])

  variantId    Int
  variant      ProductVariant @relation(fields: [variantId], references: [id])
}

model Wishlist {
  id        Int      @id @default(autoincrement())

  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  productId Int
  product   Product  @relation(fields: [productId], references: [id])

  createdAt TimestamptzString @default(now())
}
